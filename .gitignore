        end)
    end
    
    local function ApplyColor()
        local newColor = Color3.fromHSV(tempH, tempS, tempV)
        SkeletonColor = newColor
        for _, bones in pairs(SkeletonCache) do
            for i, line in pairs(bones.lines) do
                if i ~= 16 then line.Color = SkeletonColor end
            end
            if bones.headCircle then bones.headCircle.Color = SkeletonColor end
        end
    end
    
