        })
        ValGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
            ColorSequenceKeypoint.new(1, Color3.fromHSV(tempH, tempS, 1)),
        })
    end
    
    local function MakeSliderDraggable(frame, knob, onDrag)
        local dragging = false
        local function Update(input)
            local rel = math.clamp((input.Position.X - frame.AbsolutePosition.X) / frame.AbsoluteSize.X, 0, 1)
            onDrag(rel)
            UpdatePreview()
        end
        frame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                Update(input)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                Update(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end
    
    MakeSliderDraggable(HueFrame, HueKnob, function(v) tempH = v end)
    MakeSliderDraggable(SatFrame, SatKnob, function(v) tempS = v end)
    MakeSliderDraggable(ValFrame, ValKnob, function(v) tempV = v end)
    
