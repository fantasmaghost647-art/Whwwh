        CreateSkeleton(p)
    end)
    Players.PlayerRemoving:Connect(function(p)
        RemoveESP(p)
        RemoveSkeleton(p)
    end)
    
    -- RENDER LOOP (SEM FAST RELOAD/FIRE)
    RunService.RenderStepped:Connect(function()
        local canShowVisuals = not BypassTelaEnabled
        local Cam = workspace.CurrentCamera
        
        if (AimbotEnabled or MagneticEnabled) and canShowVisuals then
            FOVCircle.Position = Cam.ViewportSize / 2
            FOVCircle.Radius = FOV
            FOVCircle.Visible = true
        else
            FOVCircle.Visible = false
        end
        
        if TelaEsticada then
            Cam.CFrame = Cam.CFrame * CFrame.new(0, 0, 0, 1, 0, 0, 0, ResolucaoValor, 0, 0, 0, 1)
        end
        
        local target = GetTarget()
        if MagneticEnabled and target and target.Parent then
            local hrp = target.Parent:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.CFrame = Cam.CFrame * CFrame.new(0, 0, -5) end
        end
        if AimbotEnabled and target then
            Cam.CFrame = CFrame.new(Cam.CFrame.Position, target.Position) 
        end
        
        for player, esp in pairs(ESPCache) do
            local char = player.Character
            local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local function hideAllESP()
                esp.Box.Visible = false
                esp.Line.Visible = false
                esp.Name.Visible = false
                esp.Distance.Visible = false
                esp.HealthOutline.Visible = false
                esp.HealthBar.Visible = false
                esp.Arrow.Visible = false
                for _, line in ipairs(esp.CornerLines) do line.Visible = false end
            end
            if not ESPEnabled or not IsEnemy(player) or not hrp or not hum or hum.Health <= 0 or not canShowVisuals then
                hideAllESP()
                continue
            end
            local rawPos, onScreen = Cam:WorldToViewportPoint(hrp.Position)
            if not onScreen then
                hideAllESP()
                continue
            end
            local pos = Vector2.new(rawPos.X, rawPos.Y)
            local teamColor = player.TeamColor.Color or Color3.fromRGB(255,255,255)
            local distance = (Cam.CFrame.Position - hrp.Position).Magnitude
            local height = math.clamp(2000 / distance, 25, 300)
            local width = height / 2
            local topLeft = Vector2.new(pos.X - width/2, pos.Y - height/2)
            local topRight = Vector2.new(pos.X + width/2, pos.Y - height/2)
            local bottomLeft = Vector2.new(pos.X - width/2, pos.Y + height/2)
            local bottomRight = Vector2.new(pos.X + width/2, pos.Y + height/2)
            
            esp.Box.Size = Vector2.new(width, height)
            esp.Box.Position = topLeft
            esp.Box.Color = teamColor
            esp.Box.Visible = BoxESP
            
            local cornerLen = math.min(width, height) * 0.28
            esp.CornerLines[1].From = topLeft
            esp.CornerLines[1].To = Vector2.new(topLeft.X + cornerLen, topLeft.Y)
            esp.CornerLines[2].From = topLeft
            esp.CornerLines[2].To = Vector2.new(topLeft.X, topLeft.Y + cornerLen)
            esp.CornerLines[3].From = topRight
            esp.CornerLines[3].To = Vector2.new(topRight.X - cornerLen, topRight.Y)
            esp.CornerLines[4].From = topRight
            esp.CornerLines[4].To = Vector2.new(topRight.X, topRight.Y + cornerLen)
            esp.CornerLines[5].From = bottomLeft
            esp.CornerLines[5].To = Vector2.new(bottomLeft.X + cornerLen, bottomLeft.Y)
            esp.CornerLines[6].From = bottomLeft
            esp.CornerLines[6].To = Vector2.new(bottomLeft.X, bottomLeft.Y - cornerLen)
            esp.CornerLines[7].From = bottomRight
            esp.CornerLines[7].To = Vector2.new(bottomRight.X - cornerLen, bottomRight.Y)
            esp.CornerLines[8].From = bottomRight
            esp.CornerLines[8].To = Vector2.new(bottomRight.X, bottomRight.Y - cornerLen)
            for _, line in ipairs(esp.CornerLines) do
                line.Color = teamColor
                line.Visible = CornerBoxESP
            end
            
            esp.Line.From = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y)
            esp.Line.To = Vector2.new(pos.X, pos.Y)
            esp.Line.Color = teamColor
            esp.Line.Visible = LineESP
            
            esp.Name.Text = player.Name
            esp.Name.Position = Vector2.new(pos.X, pos.Y - height/2 - 14)
            esp.Name.Color = teamColor
            esp.Name.Visible = NameESP
            
            esp.Distance.Text = math.floor(distance).."m"
            esp.Distance.Position = Vector2.new(pos.X, pos.Y + height/2 + 2)
            esp.Distance.Color = Color3.fromRGB(255,255,255)
            esp.Distance.Visible = DistanceESP
            
            local hpPercent = hum.Health / hum.MaxHealth
            esp.HealthOutline.Visible = HealthESP
            esp.HealthOutline.From = Vector2.new(pos.X - width/2 - 6, pos.Y - height/2)
            esp.HealthOutline.To = Vector2.new(pos.X - width/2 - 6, pos.Y + height/2)
            esp.HealthBar.Visible = HealthESP
            esp.HealthBar.From = Vector2.new(pos.X - width/2 - 6, pos.Y + height/2)
            esp.HealthBar.To = Vector2.new(pos.X - width/2 - 6, (pos.Y + height/2) - (height * hpPercent))
            esp.HealthBar.Color = Color3.fromHSV(hpPercent * 0.3, 1, 1)
            
            if ArrowESP then
                local screenCenter = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
                local dir = pos - screenCenter
                if dir.Magnitude > 1 then dir = dir.Unit else dir = Vector2.new(0, 1) end
                local arrowPos = Vector2.new(topRight.X + 8, pos.Y)
                local arrowSize = 10
                esp.Arrow.PointA = arrowPos + Vector2.new(-arrowSize, 0)
                esp.Arrow.PointB = arrowPos + Vector2.new(arrowSize * 0.4, -arrowSize * 0.7)
                esp.Arrow.PointC = arrowPos + Vector2.new(arrowSize * 0.4, arrowSize * 0.7)
                esp.Arrow.Color = teamColor
                esp.Arrow.Visible = true
            else
                esp.Arrow.Visible = false
            end
        end
        
        if SkeletonESP and canShowVisuals then
            for player, _ in pairs(SkeletonCache) do
                if player.Character and IsEnemy(player) then
                    UpdateSkeleton(player, Cam, canShowVisuals, nil)
                else
                    local bones = SkeletonCache[player]
                    if bones then
                        for _, line in pairs(bones.lines) do line.Visible = false end
                        for _, outline in pairs(bones.outlines) do outline.Visible = false end
                        if bones.headCircle then bones.headCircle.Visible = false end
                        if bones.headOutline then bones.headOutline.Visible = false end
                    end
                end
            end
        else
            for _, bones in pairs(SkeletonCache) do
                for _, line in pairs(bones.lines) do line.Visible = false end
                for _, outline in pairs(bones.outlines) do outline.Visible = false end
                if bones.headCircle then bones.headCircle.Visible = false end
                if bones.headOutline then bones.headOutline.Visible = false end
            end
        end
        
        BlackWeaponLocal()
    end)
    
    -- ============================================
    -- ABA AIMBOT
    -- ============================================
    criarSecao(PagAimbot, "Aimbot")
    local rowAim1 = criarRow(PagAimbot)
    criarCheckbox(rowAim1, "Ativar Aimbot", function(v) AimbotEnabled = v end, 150)
    criarCheckbox(rowAim1, "Ativar Magnetic", function(v) MagneticEnabled = v end, 160)
    
    local rowAim2 = criarRow(PagAimbot)
    criarDragFloat(rowAim2, "FOV", 120, 50, 500, 0.5, function(v) FOV = v end, 250)
    
    criarDivisoria(PagAimbot)
    criarSecao(PagAimbot, "Extras")
    local rowAim3 = criarRow(PagAimbot)
    criarCheckbox(rowAim3, "Black Weapon", function(v) BlackWeapon = v end, 150)
    criarCheckbox(rowAim3, "Check Time", function(v) TeamCheck = v end, 130)

        -- ============================================
    -- ABA ESP
    -- ============================================
    criarSecao(PagESP, "Sistema ESP")
    local rowESP1 = criarRow(PagESP)
    criarCheckbox(rowESP1, "ESP Geral (Ativar)", function(v) ESPEnabled = v end, 180)
    
    criarDivisoria(PagESP)
    criarSecao(PagESP, "Caixas & Indicadores")
    local rowESP2 = criarRow(PagESP)
    criarCheckbox(rowESP2, "Box ESP", function(v) BoxESP = v end, 120)
    criarCheckbox(rowESP2, "Corner Box ESP", function(v) CornerBoxESP = v end, 150)
    criarCheckbox(rowESP2, "Arrow ESP", function(v) ArrowESP = v end, 130)
    
    criarSecao(PagESP, "Informações")
    local rowESP3 = criarRow(PagESP)
    criarCheckbox(rowESP3, "Name ESP", function(v) NameESP = v end, 120)
    criarCheckbox(rowESP3, "Distance ESP", function(v) DistanceESP = v end, 140)
    criarCheckbox(rowESP3, "ESP Vida", function(v) HealthESP = v end, 130)
    criarCheckbox(rowESP3, "Line ESP", function(v) LineESP = v end, 120)
    
    -- ============================================
    -- ABA SKELETON
    -- ============================================
    criarSecao(PagSkeleton, "Esqueleto")
    local rowSkel1 = criarRow(PagSkeleton)
    criarCheckbox(rowSkel1, "ESP Skeleton", function(v) SkeletonESP = v end, 180)
    criarBotao(rowSkel1, "🎨 Cor do Skeleton", function()
        PickerFrame.Visible = not PickerFrame.Visible
        if PickerFrame.Visible then
            tempH, tempS, tempV = SkeletonColor:ToHSV()
            UpdatePreview()
        end
    end, 200)
    
    criarDivisoria(PagSkeleton)
    criarSecao(PagSkeleton, "Opacidade do Skeleton")
    local rowSkel2 = criarRow(PagSkeleton)
    criarDragFloat(rowSkel2, "Opacidade (0 = transparente / 10 = sólido)", 5.0, 0, 10, 0.1, function(v) 
        SkeletonOpacity = v 
        ApplySkeletonOpacity()
    end, 380, true)
    
    -- ============================================
    -- ABA TELA
    -- ============================================
    criarSecao(PagTela, "Resolução & Otimização")
    local rowTela1 = criarRow(PagTela)
    criarCheckbox(rowTela1, "Tela Esticada", function(v) TelaEsticada = v end, 160)
    criarBotao(rowTela1, "⚡ Otimizar Jogo (FPS Boost)", function()
        for _, v in pairs(game:GetDescendants()) do
            if v:IsA("DataModelMesh") or v:IsA("CharacterMesh") or v:IsA("BasePart") then
                if v:IsA("BasePart") then
                    v.Material = Enum.Material.SmoothPlastic
                    v.Reflectance = 0
                end
            elseif v:IsA("Decal") or v:IsA("Texture") then
                v:Destroy()
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
                v.Enabled = false
            end
        end
        settings().Rendering.QualityLevel = 1
    end, 230)
    
    -- ============================================
    -- ABA CONFIG
    -- ============================================
    criarSecao(PagConfig, "Bypass")
    local rowCfg1 = criarRow(PagConfig)
    criarCheckbox(rowCfg1, "Bypass de Transmissão", function(v)
        BypassTelaEnabled = v
        local targetGui = parentGui:FindFirstChild("ImGuiTouchNX")
        if typeof(set_gui_protection) == "function" then
            if targetGui then set_gui_protection(targetGui, v) end
        end
        if v then
            CoreGui:SetCore("SendNotification", {Title = "Bypass Ativo", Text = "Dê 5 cliques rápidos para sumir/voltar o painel!", Duration = 5})
        end
    end, 220)
    
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not BypassTelaEnabled then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local currentTime = tick()
            if currentTime - LastClickTime > 0.5 then ClickCount = 1
            else ClickCount = ClickCount + 1 end
            LastClickTime = currentTime
            if ClickCount >= 5 then
                local toggle = parentGui:FindFirstChild("ImGuiTouchNX")
                if toggle then toggle.Enabled = not toggle.Enabled end
                ClickCount = 0
            end
        end
    end)
    
    -- ============================================
    -- TROCA DE ABAS (SEM ABA ARMAS)
    -- ============================================
    local paginas = {
        {botao = AbaAimbot,   pagina = PagAimbot},
        {botao = AbaESP,      pagina = PagESP},
        {botao = AbaSkeleton, pagina = PagSkeleton},
        {botao = AbaTela,     pagina = PagTela},
        {botao = AbaConfig,   pagina = PagConfig},
    }
    
    for _, info in ipairs(paginas) do
        info.botao.MouseButton1Click:Connect(function()
            for _, outro in ipairs(paginas) do
                if outro.botao == info.botao then
                    outro.botao.BackgroundColor3 = COR_ABA_ATIVA
                    outro.pagina.Visible = true
                else
                    outro.botao.BackgroundColor3 = COR_ABA_INATIVA
                    outro.pagina.Visible = false
                end
            end
        end)
    end
    
    -- ARRASTO
    local dragging, dragStart, startPos
    DragButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Window.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            Window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    -- MINIMIZAR
    local minimizado = false
    BtnMinimizar.MouseButton1Click:Connect(function()
        minimizado = not minimizado
        if minimizado then
            BtnMinimizar.Text = "▲"
            TweenService:Create(Body, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { Size = UDim2.new(1, 0, 0, 0) }):Play()
            TweenService:Create(Window, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { Size = UDim2.new(0, LARGURA_JANELA, 0, ALTURA_HEADER) }):Play()
        else
            BtnMinimizar.Text = "▼"
            TweenService:Create(Body, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { Size = UDim2.new(1, 0, 0, ALTURA_BODY) }):Play()
            TweenService:Create(Window, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { Size = UDim2.new(0, LARGURA_JANELA, 0, ALTURA_TOTAL) }):Play()
        end
    end)
    
    CoreGui:SetCore("SendNotification", {
        Title = "ImGuiTouchNX",
        Text = "Painel carregado! 100% seguro contra kick.",
        Duration = 4
    })
end

-- ============================================
-- LÓGICA DE VERIFICAÇÃO
-- ============================================
EnterBtn.MouseButton1Click:Connect(function()
    local UserData = Whitelist[LocalPlayer.Name]  
    if UserData then
        if KeyInput.Text == MasterKey then
            local Expiracao = CheckExpiry(UserData.Data)
            if os.time() < Expiracao then
                IniciarPainel()
            else
                EnterBtn.Text = "ACESSO EXPIRADO"
                EnterBtn.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
                task.wait(2)
                EnterBtn.Text = "ATIVAR"
                EnterBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
            end
        else
            EnterBtn.Text = "KEY INCORRETA"
            EnterBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
            task.wait(2)
            EnterBtn.Text = "ATIVAR"
            EnterBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        end
    else
        EnterBtn.Text = "USUÁRIO NÃO AUTORIZADO"
        task.wait(2)
        EnterBtn.Text = "ATIVAR"
        EnterBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
    end
end)
