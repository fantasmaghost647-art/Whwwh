    local function criarAba(nome, ativa)
        local Tab = Instance.new("TextButton")
        Tab.BackgroundColor3 = ativa and COR_ABA_ATIVA or COR_ABA_INATIVA
        Tab.BorderSizePixel = 0
        Tab.Text = nome
        Tab.TextColor3 = COR_TEXTO
        Tab.TextSize = 12
        Tab.Font = Enum.Font.Code
        Tab.AutoButtonColor = false
        Tab.Parent = TabBar
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 4)
        corner.Parent = Tab
        local size = TextService:GetTextSize(nome, 12, Enum.Font.Code, Vector2.new(1000, 100))
        Tab.Size = UDim2.new(0, size.X + 16, 0, 20)
        return Tab
    end
    
    -- ✅ Aba "Armas" REMOVIDA
    local AbaAimbot   = criarAba("Aimbot", true)
    local AbaESP      = criarAba("ESP", false)
    local AbaSkeleton = criarAba("Skeleton", false)
    local AbaTela     = criarAba("Tela", false)
    local AbaConfig   = criarAba("Config", false)
    
    -- CONTENT
    local Content = Instance.new("Frame")
    Content.Size = UDim2.new(1, 0, 1, -30)
    Content.Position = UDim2.new(0, 0, 0, 30)
    Content.BackgroundTransparency = 1
    Content.ClipsDescendants = true
    Content.Parent = Body
    
    local function criarPagina()
        local Pag = Instance.new("ScrollingFrame")
        Pag.Size = UDim2.new(1, -8, 1, -8)
        Pag.Position = UDim2.new(0, 4, 0, 4)
        Pag.BackgroundTransparency = 1
        Pag.BorderSizePixel = 0
        Pag.ScrollBarThickness = 4
        Pag.ScrollBarImageColor3 = COR_ABA_ATIVA
        Pag.CanvasSize = UDim2.new(0, 0, 0, 0)
        Pag.AutomaticCanvasSize = Enum.AutomaticSize.Y
        Pag.Visible = false
        Pag.Parent = Content
        local Layout = Instance.new("UIListLayout")
        Layout.FillDirection = Enum.FillDirection.Vertical
        Layout.Padding = UDim.new(0, 6)
        Layout.SortOrder = Enum.SortOrder.LayoutOrder
        Layout.Parent = Pag
        local Pad = Instance.new("UIPadding")
        Pad.PaddingTop = UDim.new(0, 6)
        Pad.PaddingLeft = UDim.new(0, 4)
        Pad.PaddingRight = UDim.new(0, 4)
        Pad.Parent = Pag
        return Pag
    end
    
    local PagAimbot   = criarPagina()
    local PagESP      = criarPagina()
    local PagSkeleton = criarPagina()
    local PagTela     = criarPagina()
    local PagConfig   = criarPagina()
    PagAimbot.Visible = true
    
    -- ============================================
    -- VARIÁVEIS
    -- ============================================
    local ESPEnabled = false
    local BoxESP = false
    local CornerBoxESP = false
    local ArrowESP = false
    local LineESP = false
    local NameESP = false
    local DistanceESP = false
    local HealthESP = false
    local SkeletonESP = false
    local SkeletonOpacity = 5.0
    local AimbotEnabled = false
    local MagneticEnabled = false 
    local TeamCheck = false
    local FOV = 120
    local BlackWeapon = false
    local BypassTelaEnabled = false
    local ClickCount = 0
    local LastClickTime = 0
    local TelaEsticada = false
    local ResolucaoValor = 0.44
    
    local ordemGlobal = 0
    local function proximaOrdem()
        ordemGlobal = ordemGlobal + 1
        return ordemGlobal
    end
    
    -- ROW
    local function criarRow(parent)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 22)
        row.BackgroundTransparency = 1
        row.LayoutOrder = proximaOrdem()
        row.Parent = parent
        local layout = Instance.new("UIListLayout")
        layout.FillDirection = Enum.FillDirection.Horizontal
        layout.Padding = UDim.new(0, 12)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Parent = row
        return row
    end
    
    -- CHECKBOX
    local function criarCheckbox(parent, texto, callback, largura)
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(0, largura or 180, 0, 22)
        frame.BackgroundTransparency = 1
        frame.LayoutOrder = proximaOrdem()
        frame.Parent = parent
    
        local check = Instance.new("TextButton")
        check.Size = UDim2.new(0, 18, 0, 18)
        check.Position = UDim2.new(0, 0, 0, 2)
        check.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        check.BorderSizePixel = 0
        check.Text = ""
        check.AutoButtonColor = false
        check.Parent = frame
    
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 2)
        corner.Parent = check
    
        local mark = Instance.new("TextLabel")
        mark.Size = UDim2.new(1, 0, 1, 0)
        mark.BackgroundTransparency = 1
        mark.Text = ""
        mark.TextColor3 = COR_TEXTO
        mark.TextSize = 14
        mark.Font = Enum.Font.Code
        mark.Parent = check
    
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -24, 1, 0)
        label.Position = UDim2.new(0, 24, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = texto
        label.TextColor3 = COR_TEXTO
        label.TextSize = 12
        label.Font = Enum.Font.Code
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.TextYAlignment = Enum.TextYAlignment.Center
        label.Parent = frame
    
        local estado = false
        check.MouseButton1Click:Connect(function()
            estado = not estado
            if estado then
                mark.Text = "✓"
                check.BackgroundColor3 = COR_ABA_ATIVA
            else
                mark.Text = ""
                check.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            end
            pcall(callback, estado)
        end)
        return frame
    end
    
    -- DRAGFLOAT
    local function criarDragFloat(parent, labelTexto, valorInicial, min, max, velocidade, callback, larguraPx, decimal)
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(0, larguraPx or 260, 0, 22)
        frame.BackgroundTransparency = 1
        frame.LayoutOrder = proximaOrdem()
        frame.Parent = parent
    
        local bar = Instance.new("TextButton")
        bar.Size = UDim2.new(0, 120, 1, 0)
        bar.Position = UDim2.new(0, 0, 0, 0)
        bar.BackgroundColor3 = COR_DRAG_BG
        bar.BorderSizePixel = 0
        bar.Text = ""
        bar.AutoButtonColor = false
        bar.Parent = frame
    
        local barCorner = Instance.new("UICorner")
        barCorner.CornerRadius = UDim.new(0, 3)
        barCorner.Parent = bar
    
        local barStroke = Instance.new("UIStroke")
        barStroke.Color = COR_DRAG_BORDA
        barStroke.Thickness = 1
        barStroke.Parent = bar
    
        local linha = Instance.new("Frame")
        linha.Size = UDim2.new(0, 12, 1, 0)
        linha.BackgroundColor3 = COR_DRAG_LINHA
        linha.BorderSizePixel = 0
        linha.ZIndex = 2
        linha.Parent = bar
    
        local linhaCorner = Instance.new("UICorner")
        linhaCorner.CornerRadius = UDim.new(1, 0)
        linhaCorner.Parent = linha
    
        local valueLabel = Instance.new("TextLabel")
        valueLabel.Size = UDim2.new(0, 60, 1, 0)
        valueLabel.Position = UDim2.new(0, 16, 0, 0)
        valueLabel.BackgroundTransparency = 1
        valueLabel.Text = string.format(decimal and "%.1f" or "%.0f", valorInicial)
        valueLabel.TextColor3 = COR_TEXTO
        valueLabel.TextSize = 12
        valueLabel.Font = Enum.Font.Code
        valueLabel.TextXAlignment = Enum.TextXAlignment.Left
        valueLabel.TextYAlignment = Enum.TextYAlignment.Center
        valueLabel.ZIndex = 3
        valueLabel.Parent = bar
    
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(0, larguraPx and (larguraPx - 130) or 130, 1, 0)
        nameLabel.Position = UDim2.new(0, 130, 0, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = labelTexto
        nameLabel.TextColor3 = COR_TEXTO
        nameLabel.TextSize = 12
        nameLabel.Font = Enum.Font.Code
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        nameLabel.TextYAlignment = Enum.TextYAlignment.Center
        nameLabel.Parent = frame
    
        local valorAtual = valorInicial
        local arrastando = false
        local startX = 0
        local valorInicialDrag = 0
    
        local function atualizar()
            valueLabel.Text = string.format(decimal and "%.1f" or "%.0f", valorAtual)
            local pct = (valorAtual - min) / (max - min)
            linha.Position = UDim2.new(pct, -6, 0, 0)
        end
        atualizar()
    
        bar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                arrastando = true
                startX = input.Position.X
                valorInicialDrag = valorAtual
                bar.BackgroundColor3 = Color3.fromRGB(8, 25, 60)
            end
        end)
    
        UserInputService.InputChanged:Connect(function(input)
            if not arrastando then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
                local deltaX = input.Position.X - startX
                local novoValor = valorInicialDrag + (deltaX * velocidade)
                novoValor = math.clamp(novoValor, min, max)
                if decimal then
                    novoValor = math.floor(novoValor * 10 + 0.5) / 10
                else
                    novoValor = math.floor(novoValor + 0.5)
                end
                valorAtual = novoValor
                atualizar()
                pcall(callback, valorAtual)
            end
        end)
    
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                if arrastando then
                    arrastando = false
                    bar.BackgroundColor3 = COR_DRAG_BG
                end
            end
        end)
    
        return frame
    end
    
    -- BOTÃO
    local function criarBotao(parent, texto, callback, larguraPx)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, larguraPx or 200, 0, 26)
        btn.BackgroundColor3 = COR_ABA_ATIVA
        btn.BorderSizePixel = 0
        btn.Text = texto
        btn.TextColor3 = COR_TEXTO
        btn.TextSize = 13
        btn.Font = Enum.Font.Code
        btn.AutoButtonColor = false
        btn.LayoutOrder = proximaOrdem()
        btn.Parent = parent
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 4)
        corner.Parent = btn
        btn.MouseEnter:Connect(function() btn.BackgroundColor3 = Color3.fromRGB(50, 170, 255) end)
        btn.MouseLeave:Connect(function() btn.BackgroundColor3 = COR_ABA_ATIVA end)
        btn.MouseButton1Click:Connect(function() pcall(callback) end)
        return btn
    end
    
    -- SECTION
    local function criarSecao(parent, texto)
        local sec = Instance.new("TextLabel")
        sec.Size = UDim2.new(1, 0, 0, 20)
        sec.BackgroundTransparency = 1
        sec.Text = "▸ " .. texto
        sec.TextColor3 = COR_ABA_ATIVA
        sec.TextSize = 13
        sec.Font = Enum.Font.Code
        sec.TextXAlignment = Enum.TextXAlignment.Left
        sec.LayoutOrder = proximaOrdem()
        sec.Parent = parent
        return sec
    end
    
    -- DIVISÓRIA
    local function criarDivisoria(parent)
        local div = Instance.new("Frame")
        div.Size = UDim2.new(1, 0, 0, 1)
        div.BackgroundColor3 = COR_LINHA
        div.BackgroundTransparency = 0.6
        div.BorderSizePixel = 0
        div.LayoutOrder = proximaOrdem()
        div.Parent = parent
    end
    
    -- ESP CACHE
    local ESPCache = {}
    local function CreateESP(player)
        if player == LocalPlayer then return end
        ESPCache[player] = {
            Box = Drawing.new("Square"),
            CornerLines = {
                Drawing.new("Line"), Drawing.new("Line"),
                Drawing.new("Line"), Drawing.new("Line"),
                Drawing.new("Line"), Drawing.new("Line"),
                Drawing.new("Line"), Drawing.new("Line"),
            },
            Line = Drawing.new("Line"),
            Name = Drawing.new("Text"),
            Distance = Drawing.new("Text"),
            HealthOutline = Drawing.new("Line"),
            HealthBar = Drawing.new("Line"),
            Arrow = Drawing.new("Triangle"),
        }
        local esp = ESPCache[player]
        esp.Box.Thickness = 1
        esp.Box.Filled = false
        esp.Line.Thickness = 1
        esp.Name.Size = 13
        esp.Name.Center = true
        esp.Name.Outline = true
        esp.Distance.Size = 13
        esp.Distance.Center = true
        esp.Distance.Outline = true
        esp.HealthOutline.Thickness = 3
        esp.HealthBar.Thickness = 2
        for _, line in ipairs(esp.CornerLines) do
            line.Thickness = 2
            line.Visible = false
        end
        esp.Arrow.Thickness = 1
        esp.Arrow.Filled = true
        esp.Arrow.Visible = false
    end
    
    local function RemoveESP(player)
        if ESPCache[player] then
            for _, v in pairs(ESPCache[player]) do 
                if type(v) == "table" then
                    for _, sub in pairs(v) do sub:Remove() end
                else v:Remove() end
            end
            ESPCache[player] = nil
        end
    end
    
    -- SKELETON
    local R15Connections = {
        {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
        {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
        {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
        {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
        {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
    }
    local R6Connections = {
        {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
        {"Torso", "Left Leg"}, {"Torso", "Right Leg"},
    }
    
    local SkeletonColor = Color3.fromRGB(0, 255, 0)
    local SkeletonCache = {}
    
    local function CreateSkeleton(player)
        if player == LocalPlayer then return end
        if SkeletonCache[player] then return end
        local bones = { lines = {}, outlines = {}, headCircle = nil, headOutline = nil }
        for i = 1, 16 do
            local outline = Drawing.new("Line")
            outline.Thickness = 6
            outline.Color = Color3.fromRGB(0, 0, 0)
            outline.Transparency = 0.3
            outline.Visible = false
            bones.outlines[i] = outline
            local line = Drawing.new("Line")
            line.Thickness = 4
            line.Color = SkeletonColor
            line.Transparency = 0
            line.Visible = false
            bones.lines[i] = line
        end
        bones.headOutline = Drawing.new("Circle")
        bones.headOutline.Thickness = 5
        bones.headOutline.Color = Color3.fromRGB(0, 0, 0)
        bones.headOutline.Filled = false
        bones.headOutline.NumSides = 32
        bones.headOutline.Transparency = 0.3
        bones.headOutline.Visible = false
        bones.headCircle = Drawing.new("Circle")
        bones.headCircle.Thickness = 3.5
        bones.headCircle.Color = SkeletonColor
        bones.headCircle.Filled = false
        bones.headCircle.NumSides = 32
        bones.headCircle.Transparency = 0
        bones.headCircle.Visible = false
        SkeletonCache[player] = bones
    end
    
    local function ApplySkeletonOpacity()
        local transparency = 1 - (SkeletonOpacity / 10)
        local outlineTransparency = transparency * 0.5
        
        for _, bones in pairs(SkeletonCache) do
            for _, line in pairs(bones.lines) do
                line.Transparency = transparency
            end
            for _, outline in pairs(bones.outlines) do
                outline.Transparency = outlineTransparency
            end
            if bones.headCircle then 
                bones.headCircle.Transparency = transparency 
            end
            if bones.headOutline then 
                bones.headOutline.Transparency = outlineTransparency 
            end
        end
    end
    
    local function RemoveSkeleton(player)
        if SkeletonCache[player] then
            local bones = SkeletonCache[player]
            for _, line in pairs(bones.lines) do line:Remove() end
            for _, outline in pairs(bones.outlines) do outline:Remove() end
            if bones.headCircle then bones.headCircle:Remove() end
            if bones.headOutline then bones.headOutline:Remove() end
            SkeletonCache[player] = nil
        end
    end
    
    local function UpdateSkeleton(player, camera, canShowVisuals, _teamColor)
        local bones = SkeletonCache[player]
        if not bones then return end
        local char = player.Character
        local hideAll = function()
            for _, line in pairs(bones.lines) do line.Visible = false end
            for _, outline in pairs(bones.outlines) do outline.Visible = false end
            if bones.headCircle then bones.headCircle.Visible = false end
            if bones.headOutline then bones.headOutline.Visible = false end
        end
        if not char then hideAll() return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then hideAll() return end
        if not SkeletonESP or not canShowVisuals then hideAll() return end
        local isR15 = char:FindFirstChild("UpperTorso") ~= nil
        local connections = isR15 and R15Connections or R6Connections
        local bonePositions = {}
        for _, connection in ipairs(connections) do
            local part1 = char:FindFirstChild(connection[1])
            local part2 = char:FindFirstChild(connection[2])
            if part1 and part2 then
                local pos1, onScreen1 = camera:WorldToViewportPoint(part1.Position)
                local pos2, onScreen2 = camera:WorldToViewportPoint(part2.Position)
                table.insert(bonePositions, {
                    pos1 = Vector2.new(pos1.X, pos1.Y),
                    pos2 = Vector2.new(pos2.X, pos2.Y),
                    onScreen = onScreen1 and onScreen2
                })
            else
                table.insert(bonePositions, { onScreen = false })
            end
        end
        
        local transparency = 1 - (SkeletonOpacity / 10)
        local outlineTransparency = transparency * 0.5
        
        for i = 1, 16 do
            local data = bonePositions[i]
            local line = bones.lines[i]
            local outline = bones.outlines[i]
            if data and data.onScreen and i <= #connections then
                outline.From = data.pos1
                outline.To = data.pos2
                outline.Visible = true
                outline.Transparency = outlineTransparency
                line.From = data.pos1
                line.To = data.pos2
                line.Color = SkeletonColor
                line.Visible = true
                line.Transparency = transparency
            else
                line.Visible = false
                outline.Visible = false
            end
        end
        
        local extraLine = bones.lines[16]
        local extraOutline = bones.outlines[16]
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            local handle = tool:FindFirstChild("Handle")
            local rightHand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
            if handle and rightHand then
                local hPos, hOn = camera:WorldToViewportPoint(handle.Position)
                local rhPos, rhOn = camera:WorldToViewportPoint(rightHand.Position)
                if hOn and rhOn then
                    extraOutline.From = Vector2.new(rhPos.X, rhPos.Y)
                    extraOutline.To = Vector2.new(hPos.X, hPos.Y)
                    extraOutline.Visible = true
                    extraOutline.Transparency = outlineTransparency
                    extraLine.From = Vector2.new(rhPos.X, rhPos.Y)
                    extraLine.To = Vector2.new(hPos.X, hPos.Y)
                    extraLine.Color = Color3.fromRGB(255, 255, 0)
                    extraLine.Visible = true
                    extraLine.Transparency = transparency
                else
                    extraLine.Visible = false
                    extraOutline.Visible = false
                end
            else
                extraLine.Visible = false
                extraOutline.Visible = false
            end
        else
            extraLine.Visible = false
            extraOutline.Visible = false
        end
        
        local head = char:FindFirstChild("Head")
        if head then
            local headPos, headOn = camera:WorldToViewportPoint(head.Position)
            if headOn then
                local headSize = head.Size
                local headCFrame = head.CFrame
                local topWorld = headCFrame * CFrame.new(0, headSize.Y / 2, 0)
                local bottomWorld = headCFrame * CFrame.new(0, -headSize.Y / 2, 0)
                local leftWorld = headCFrame * CFrame.new(-headSize.X / 2, 0, 0)
                local rightWorld = headCFrame * CFrame.new(headSize.X / 2, 0, 0)
                local topScreen = camera:WorldToViewportPoint(topWorld.Position)
                local bottomScreen = camera:WorldToViewportPoint(bottomWorld.Position)
                local leftScreen = camera:WorldToViewportPoint(leftWorld.Position)
                local rightScreen = camera:WorldToViewportPoint(rightWorld.Position)
                local verticalRadius = math.abs(topScreen.Y - bottomScreen.Y) / 2
                local horizontalRadius = math.abs(rightScreen.X - leftScreen.X) / 2
                local radius = (verticalRadius + horizontalRadius) / 2
                radius = math.clamp(radius, 4, 200)
                bones.headOutline.Position = Vector2.new(headPos.X, headPos.Y)
                bones.headOutline.Radius = radius + 2
                bones.headOutline.Visible = true
                bones.headOutline.Transparency = outlineTransparency
                bones.headCircle.Position = Vector2.new(headPos.X, headPos.Y)
                bones.headCircle.Radius = radius
                bones.headCircle.Color = SkeletonColor
                bones.headCircle.Visible = true
                bones.headCircle.Transparency = transparency
            else
                bones.headCircle.Visible = false
                bones.headOutline.Visible = false
            end
        else
            bones.headCircle.Visible = false
            bones.headOutline.Visible = false
        end
    end
    
    -- COMBATE
    local function IsEnemy(targetPlayer)
        if not TeamCheck then return true end
        if not LocalPlayer.Team or not targetPlayer.Team then return true end
        return targetPlayer.Team ~= LocalPlayer.Team
    end
    
    local function IsVisible(part)
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {LocalPlayer.Character, workspace.CurrentCamera}
        params.FilterType = Enum.RaycastFilterType.Blacklist
        local ray = workspace:Raycast(workspace.CurrentCamera.CFrame.Position, part.Position - workspace.CurrentCamera.CFrame.Position, params)
        return ray == nil or ray.Instance:IsDescendantOf(part.Parent)
    end
    
    local function GetTarget()
        local closest, shortest = nil, math.huge
        local center = workspace.CurrentCamera.ViewportSize / 2
        for _,p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and IsEnemy(p) and p.Character then
                local head = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("UpperTorso")
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if head and hum and hum.Health > 0 then
                    local pos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(head.Position)
                    if onScreen and (MagneticEnabled or IsVisible(head)) then
                        local mag = (Vector2.new(pos.X, pos.Y) - center).Magnitude        
                        if mag < FOV and mag < shortest then        
                            shortest = mag        
                            closest = head        
                        end
                    end
                end
            end
        end
        return closest
    end
    
    local function BlackWeaponLocal()
        if not BlackWeapon then return end
        local char = LocalPlayer.Character
        if not char then return end
        for _,tool in pairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                for _,p in pairs(tool:GetDescendants()) do
                    if p:IsA("BasePart") then        
                        p.Color = Color3.fromRGB(0,0,0)        
                        p.Material = Enum.Material.SmoothPlastic        
                    end
                end
            end
        end
    end
    
